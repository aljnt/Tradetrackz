# ==========================================
# ALPHATRACK - CLÉS API DONNÉES DE MARCHÉ
# ==========================================
# Remplir avec vos clés d'API (gratuites) :

# 1. TwelveData (Recommandé en priorité - Forex, Or XAUUSD, CFD, Crypto, Indices)
# Obtenir gratuitement (800 req/jour) sur : https://twelvedata.com
TWELVEDATA_API_KEY=votre_cle_twelvedata_ici

# 2. Finnhub (Pour les indices SPX, NDX, DJI et actions américaines)
# Obtenir gratuitement sur : https://finnhub.io
FINNHUB_API_KEY=votre_cle_finnhub_ici

# 3. Alpha Vantage (Backup Forex & Données historiques)
# Obtenir gratuitement sur : https://www.alphavantage.co
ALPHAVANTAGE_API_KEY=votre_cle_alphavantage_ici
